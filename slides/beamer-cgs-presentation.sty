\defbeamertemplate*{title page}{cgs}[1][]
{
	\center
	\hfill\logo\par
	\vspace{-0.66cm}
	\usebeamerfont{title}\inserttitle\par
	\smallskip
	\usebeamerfont{author}\usebeamercolor[fg]{title}\insertauthor\par
	\smallskip
	\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertinstitute\par
	\bigskip
	\inserttitlegraphic\par
	\bigskip
	\smallskip
	\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par
	\usebeamerfont{date}\insertdate\par
}

\defbeamertemplate*{frametitle}{cgs}
{
	\begin{beamercolorbox}[left, leftskip=0.5cm, ht=8mm, dp=1mm, wd=\paperwidth]{frametitle}
		\usebeamerfont{frametitle}\insertframetitle{}
	\end{beamercolorbox}
	\nointerlineskip
	\vspace{-8mm}
	\begin{beamercolorbox}[right, rightskip=0.5cm, ht=8mm, dp=1mm, wd=\paperwidth]{}
		\logo
	\end{beamercolorbox}
}

\defbeamertemplate*{footline}{cgs}
{
\hbox{%
	\begin{beamercolorbox}[wd=\paperwidth, ht=0.5mm, dp=.2mm]{topfootline}%
	\end{beamercolorbox}%
}
\hbox{%
	\begin{beamercolorbox}[left, leftskip=0.5cm, rightskip=0.5cm, dp=1mm, wd=\paperwidth]{footline}%
		\insertframenumber \quad \insertshorttitle~\ifx\insertsectionhead\empty\else|~\insertsectionhead\fi
		\hfill
		\insertsubtitle \quad \insertshortdate\par
	\end{beamercolorbox}%
}
}

